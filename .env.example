# Copy to .env and fill in what you use. All optional.
# Generator order: Claude (if its key is set) → Groq (if its key is set) → extractive fallback.

# Claude (paid API; a Claude Pro/Max subscription does not include API credits)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# Groq (free tier): create a key at console.groq.com → API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Force one generator: claude | groq | extractive
GENERATOR=
